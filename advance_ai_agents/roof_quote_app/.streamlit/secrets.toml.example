# Paste these into Streamlit Cloud: App Settings → Secrets
# Or rename this file to secrets.toml for local use

ANTHROPIC_API_KEY = "sk-ant-your-key-here"

# Optional satellite imagery — priority: Nearmap > Google > Mapbox > ESRI (free)
# NEARMAP_API_KEY = "your-nearmap-api-key"       # highest-res aerial + AI roof measurements
# GOOGLE_MAPS_API_KEY = "your-google-maps-key"   # high-res satellite + Street View
# MAPBOX_TOKEN = "your-mapbox-token"             # alternative to Google Maps

# Optional company defaults (pre-fills the sidebar)
COMPANY_NAME = "Your Roofing Co."
COMPANY_PHONE = "(555) 000-0000"
COMPANY_LICENSE = "ROC-XXXXXX"
TAX_RATE = "0.0"
