# Rename this file to secrets.toml for local use,
# OR paste these key=value pairs into the Streamlit Cloud secrets manager.
#
# Streamlit Cloud: App Settings → Secrets → paste contents below

ANTHROPIC_API_KEY = "your_anthropic_api_key_here"
NEBIUS_API_KEY = "your_nebius_api_key_here"

# Optional company defaults (saves typing in the sidebar)
COMPANY_NAME = "Your Roofing Co."
COMPANY_PHONE = "(555) 000-0000"
COMPANY_LICENSE = "ROC-XXXXXX"
TAX_RATE = "0.0"
