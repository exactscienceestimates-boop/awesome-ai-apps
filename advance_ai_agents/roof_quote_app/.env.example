# Required — one key covers all three agents
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional satellite imagery (without these, free ESRI imagery is used automatically)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here   # higher-res satellite + Street View
MAPBOX_TOKEN=your_mapbox_token_here                  # alternative to Google Maps

# Optional — app defaults (can also be set in the Streamlit sidebar)
COMPANY_NAME=Your Roofing Co.
COMPANY_PHONE=(555) 000-0000
COMPANY_LICENSE=ROC-XXXXXX
TAX_RATE=0.0
